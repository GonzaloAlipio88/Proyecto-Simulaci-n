# ============================================================
# Configuracion de Entorno - Frontend React/Vite
# ============================================================
# Copia este archivo como ".env" (o ".env.local") y ajusta
# los valores para tu entorno de despliegue.
#
# Para ejecucion LOCAL (predeterminado si no defines estas vars):
#   VITE_API_BASE_URL = http://127.0.0.1:8000
#   VITE_WS_URL       = ws://127.0.0.1:8000/ws
#
# Para despliegue remoto con tunel (ej.: Cloudflare Tunnel / ngrok):
#   VITE_API_BASE_URL = https://tu-dominio-publico.trycloudflare.com
#   VITE_WS_URL       = wss://tu-dominio-publico.trycloudflare.com/ws
# ============================================================

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws